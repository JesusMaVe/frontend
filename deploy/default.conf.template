server {
  listen ${NGINX_PORT};

  root /usr/share/nginx/html;

  # DNS de Docker con resolución diferida: nginx arranca aunque auth-svc o api todavía no estén.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $auth_upstream ${AUTH_SVC_UPSTREAM};
  set $api_upstream ${API_UPSTREAM};

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # /auth/token → auth-svc /token (el mismo contrato que el proxy de Vite).
  location /auth/ {
    rewrite ^/auth/(.*)$ /$1 break;
    proxy_pass $auth_upstream;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    include /etc/nginx/snippets/security-headers.conf;
  }

  location /api/ {
    proxy_pass $api_upstream;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # Assets con hash en el nombre: caché larga.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # SPA: cualquier otra ruta sirve index.html (el router decide).
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
  }
}
