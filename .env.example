# Plantilla de configuración. Crea tu .env con:  make env
# El frontend no tiene secretos: solo destinos del proxy de desarrollo y flags públicos.

# Puerto del dev server de Vite (solo en 127.0.0.1)
WEB_PORT=5173
# Destinos del proxy de Vite: /auth/* → auth-svc (repo auth) y /api/* → api (repo api)
AUTH_SVC_URL=http://127.0.0.1:8081
API_URL=http://127.0.0.1:8082
# true: console.log del JWT en cada request (para la demo). En producción: false.
VITE_LOG_JWT=true
# Deben coincidir con ITEM_TITLE_MAX / ITEM_DESCRIPTION_MAX del repo api
VITE_ITEM_TITLE_MAX=120
VITE_ITEM_DESCRIPTION_MAX=1000

# ── Imagen web (nginx: estáticos + proxy /auth y /api, un solo origen) ──
# Puerto publicado en 127.0.0.1 y puerto interno de nginx (usuario sin privilegios: > 1024)
WEB_HOST_PORT=8088
NGINX_PORT=8080
# VITE_LOG_JWT del build de la imagen. En producción: false. Para grabar la demo sobre la imagen: true.
WEB_LOG_JWT=false
# Servicios en la red compartida (nombre de servicio:puerto interno)
AUTH_SVC_UPSTREAM=http://auth-svc:8081
API_UPSTREAM=http://api:8080
# ── Red compartida con los repos auth y api (mismo valor en los tres) ──
SHARED_NETWORK=practica
SHARED_NETWORK_SUBNET=172.30.0.0/24
# IP fija de nginx en la red compartida: auth-svc confía en su X-Forwarded-For (TRUSTED_PROXIES del repo auth)
WEB_PROXY_IP=172.30.0.10
