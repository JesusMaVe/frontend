# Plantilla de configuración. Crea tu .env con:  make env
# El frontend no tiene secretos: solo destinos del proxy de desarrollo y flags públicos.

# Puerto del dev server de Vite (solo en 127.0.0.1)
WEB_PORT=5173
# Destinos del proxy de Vite: /auth/* → auth-svc (repo auth) y /api/* → api (repo api)
AUTH_SVC_URL=http://127.0.0.1:8081
API_URL=http://127.0.0.1:8082
# true: console.log del JWT en cada request (para la demo). En producción: false.
VITE_LOG_JWT=true
# Deben coincidir con ITEM_TITLE_MAX / ITEM_DESCRIPTION_MAX del repo api
VITE_ITEM_TITLE_MAX=120
VITE_ITEM_DESCRIPTION_MAX=1000
